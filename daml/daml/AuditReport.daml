module AuditReport where

-- | The ONLY contract type the regulator is ever made an observer on.
-- Everything else in this app (the agreement, its live schedule, every
-- individual call) is visible only to pledgor, securedParty, and the
-- custodian who settles movements. This template is deliberately a
-- reduced, computed summary -- never the raw per-call ledger -- and is
-- the concrete proof-point for the "sub-transaction privacy" pitch.
template AuditReport
  with
    custodian : Party
    regulator : Party
    pledgor : Party
    securedParty : Party
    agreementId : Text
    asOfNote : Text                             -- a logical timestamp/tag for the demo, e.g. "End of Day 1"
    totalPostedValue : Decimal                  -- after haircuts
    requiredCollateral : Decimal                -- what the exposure currently demands
    coverageRatio : Decimal                     -- totalPostedValue / requiredCollateral
    valuationAsOf : Text                        -- which price marks the values use
    positionsByAssetType : [(Text, Decimal)]
    concentrationByAssetType : [(Text, Decimal)] -- share of total posted value
    eligibilityBreaches : [Text]                -- asset types posted that are NOT on the agreed schedule
    concentrationBreaches : [Text]              -- asset types over their concentration limit
    narrative : Text                            -- plain-English summary (deterministic default, or a reviewed AI draft)
  where
    signatory custodian
    observer regulator
