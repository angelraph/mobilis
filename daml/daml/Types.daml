module Types where

-- | The four roles in a Mobilis collateral relationship.
-- pledgor      : posts collateral against an exposure (a.k.a. borrower).
-- securedParty : holds the exposure and calls for collateral (a.k.a. lender).
-- custodian    : the triparty/settlement agent who executes movements and
--                is the only party positioned to produce the regulator report.
-- regulator    : observer-only; sees a computed summary, never the raw book.

-- | One asset type eligible under an agreement: the haircut applied when it
-- is used to cover an exposure, and the largest share of the total posted
-- value it may make up (1.0 = no concentration limit). Modeled after the
-- eligibility-criterion / haircut pattern in Digital Asset's ex-collateral
-- reference.
data EligibilityCriterion = EligibilityCriterion
  with
    assetType : Text            -- e.g. "UST-BILL", "IG-CORP-BOND", "CASH-USD"
    haircut : Decimal           -- e.g. 0.02 for a 2% haircut
    concentrationLimit : Decimal -- e.g. 0.60: at most 60% of posted value
  deriving (Eq, Show)

-- | A single posted collateral position, tracked on the agreement's running
-- schedule (ex-collateral's "CollateralAgreementState").
--
-- postedValue is never trusted from a caller: CollateralAgreement_ProposeCall
-- recomputes it as faceValue * (1 - haircut) from the agreement's own
-- eligibility schedule (see Valuation.valueAsset) before a call is created.
data PostedAsset = PostedAsset
  with
    assetType : Text
    faceValue : Decimal
    postedValue : Decimal -- faceValue after haircut, computed on-ledger
  deriving (Eq, Show)

-- | Direction of a margin call relative to the secured party.
data CallDirection
  = NeedsMoreCollateral
  | ExcessCollateral
  deriving (Eq, Show)

-- | Mirrors ex-collateral's three call types.
data CallAction
  = Delivery with asset : PostedAsset
  | Substitution with outgoing : PostedAsset, incoming : PostedAsset
  | Return with asset : PostedAsset
  deriving (Eq, Show)

-- | Mirrors ex-collateral's Outstanding -> Disputed/Agreed -> Settled
-- state machine for a call.
data CallStatus
  = Outstanding
  | Disputed with reason : Text
  | Agreed
  | Settled
  deriving (Eq, Show)

-- | Lifecycle of a margin call: requested by the secured party, applied to
-- the live schedule's required collateral by the custodian, and fulfilled
-- only once the ledger itself confirms coverage >= required.
data MarginCallStatus
  = Requested
  | Applied
  | Fulfilled
  deriving (Eq, Show)
