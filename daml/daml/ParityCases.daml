-- GENERATED by scripts/gen-parity.py from ui/parity-cases.json. Do not edit by hand.
-- Holds the ledger rulebook (Valuation.checkMove) to the same answers as the
-- browser's mirror (ui/rules.js, tested by ui/rules.test.js).
module ParityCases where

import DA.Assert ((===))
import DA.Text (isInfixOf)
import Daml.Script
import Types
import qualified Valuation as V

parityCriteria : [EligibilityCriterion]
parityCriteria =
  [ EligibilityCriterion with assetType = "UST-BILL", haircut = 0.02, concentrationLimit = 1.0
  , EligibilityCriterion with assetType = "IG-CORP-BOND", haircut = 0.05, concentrationLimit = 0.6
  , EligibilityCriterion with assetType = "CASH-USD", haircut = 0.0, concentrationLimit = 1.0
  ]

expectOk : Text -> Decimal -> Either Text [PostedAsset] -> Script ()
expectOk _ total (Right s) = V.totalPosted s === total
expectOk name _ (Left err) = abort (name <> ": expected ok, got " <> err)

expectRejected : Text -> Text -> Either Text [PostedAsset] -> Script ()
expectRejected name needle (Left err) =
  if needle `isInfixOf` err then pure () else abort (name <> ": wrong rule: " <> err)
expectRejected name _ (Right _) = abort (name <> ": expected a rejection")

test_parity : Script ()
test_parity = do
  expectOk "deliveryAtPar" 980000.0 (V.checkMove parityCriteria [] 0.0 [] (Delivery with asset = (PostedAsset with assetType = "UST-BILL", faceValue = 1000000.0, postedValue = 0.0)))
  expectRejected "deliveryIneligible" "eligibility schedule" (V.checkMove parityCriteria [] 0.0 [] (Delivery with asset = (PostedAsset with assetType = "HY-BOND", faceValue = 1000000.0, postedValue = 0.0)))
  expectOk "deliveryAtMarkedPrice" 1407500.0 (V.checkMove parityCriteria [("IG-CORP-BOND", 0.9)] 0.0 [(PostedAsset with assetType = "UST-BILL", faceValue = 1000000.0, postedValue = 0.0)] (Delivery with asset = (PostedAsset with assetType = "IG-CORP-BOND", faceValue = 500000.0, postedValue = 0.0)))
  expectRejected "deliveryOverConcentration" "concentration limit" (V.checkMove parityCriteria [] 0.0 [(PostedAsset with assetType = "UST-BILL", faceValue = 1000000.0, postedValue = 0.0)] (Delivery with asset = (PostedAsset with assetType = "IG-CORP-BOND", faceValue = 2000000.0, postedValue = 0.0)))
  expectOk "deliveryWhileShort" 1555000.0 (V.checkMove parityCriteria [] 5000000.0 [(PostedAsset with assetType = "UST-BILL", faceValue = 1000000.0, postedValue = 0.0), (PostedAsset with assetType = "IG-CORP-BOND", faceValue = 500000.0, postedValue = 0.0)] (Delivery with asset = (PostedAsset with assetType = "CASH-USD", faceValue = 100000.0, postedValue = 0.0)))
  expectOk "returnCovered" 980000.0 (V.checkMove parityCriteria [] 400000.0 [(PostedAsset with assetType = "UST-BILL", faceValue = 1000000.0, postedValue = 0.0), (PostedAsset with assetType = "IG-CORP-BOND", faceValue = 500000.0, postedValue = 0.0)] (Return with asset = (PostedAsset with assetType = "IG-CORP-BOND", faceValue = 500000.0, postedValue = 0.0)))
  expectRejected "returnLeavesShort" "below required collateral" (V.checkMove parityCriteria [] 1400000.0 [(PostedAsset with assetType = "UST-BILL", faceValue = 1000000.0, postedValue = 0.0), (PostedAsset with assetType = "IG-CORP-BOND", faceValue = 500000.0, postedValue = 0.0)] (Return with asset = (PostedAsset with assetType = "IG-CORP-BOND", faceValue = 500000.0, postedValue = 0.0)))
  expectRejected "returnNotPosted" "not currently posted" (V.checkMove parityCriteria [] 0.0 [(PostedAsset with assetType = "UST-BILL", faceValue = 1000000.0, postedValue = 0.0)] (Return with asset = (PostedAsset with assetType = "UST-BILL", faceValue = 7.0, postedValue = 0.0)))
  expectOk "returnAtParOk" 980000.0 (V.checkMove parityCriteria [] 950000.0 [(PostedAsset with assetType = "UST-BILL", faceValue = 1000000.0, postedValue = 0.0), (PostedAsset with assetType = "IG-CORP-BOND", faceValue = 500000.0, postedValue = 0.0)] (Return with asset = (PostedAsset with assetType = "IG-CORP-BOND", faceValue = 500000.0, postedValue = 0.0)))
  expectRejected "returnBlockedAfterPriceDrop" "below required collateral" (V.checkMove parityCriteria [("UST-BILL", 0.95)] 950000.0 [(PostedAsset with assetType = "UST-BILL", faceValue = 1000000.0, postedValue = 0.0), (PostedAsset with assetType = "IG-CORP-BOND", faceValue = 500000.0, postedValue = 0.0)] (Return with asset = (PostedAsset with assetType = "IG-CORP-BOND", faceValue = 500000.0, postedValue = 0.0)))
  expectOk "returnLotAfterRemark" 0.0 (V.checkMove parityCriteria [("UST-BILL", 0.97)] 0.0 [(PostedAsset with assetType = "UST-BILL", faceValue = 1000000.0, postedValue = 0.0)] (Return with asset = (PostedAsset with assetType = "UST-BILL", faceValue = 1000000.0, postedValue = 0.0)))
  expectOk "returnOneOfTwoLots" 98.0 (V.checkMove parityCriteria [] 0.0 [(PostedAsset with assetType = "UST-BILL", faceValue = 100.0, postedValue = 0.0), (PostedAsset with assetType = "UST-BILL", faceValue = 100.0, postedValue = 0.0)] (Return with asset = (PostedAsset with assetType = "UST-BILL", faceValue = 100.0, postedValue = 0.0)))
  expectOk "substitutionOk" 1400000.0 (V.checkMove parityCriteria [] 1400000.0 [(PostedAsset with assetType = "UST-BILL", faceValue = 1000000.0, postedValue = 0.0), (PostedAsset with assetType = "IG-CORP-BOND", faceValue = 500000.0, postedValue = 0.0)] (Substitution with outgoing = (PostedAsset with assetType = "UST-BILL", faceValue = 1000000.0, postedValue = 0.0), incoming = (PostedAsset with assetType = "CASH-USD", faceValue = 925000.0, postedValue = 0.0)))
  expectRejected "substitutionLeavesShort" "below required collateral" (V.checkMove parityCriteria [] 1400000.0 [(PostedAsset with assetType = "UST-BILL", faceValue = 1000000.0, postedValue = 0.0), (PostedAsset with assetType = "IG-CORP-BOND", faceValue = 500000.0, postedValue = 0.0)] (Substitution with outgoing = (PostedAsset with assetType = "UST-BILL", faceValue = 1000000.0, postedValue = 0.0), incoming = (PostedAsset with assetType = "CASH-USD", faceValue = 100.0, postedValue = 0.0)))
  expectRejected "substitutionOverConcentration" "concentration limit" (V.checkMove parityCriteria [] 1400000.0 [(PostedAsset with assetType = "UST-BILL", faceValue = 1000000.0, postedValue = 0.0), (PostedAsset with assetType = "IG-CORP-BOND", faceValue = 500000.0, postedValue = 0.0)] (Substitution with outgoing = (PostedAsset with assetType = "UST-BILL", faceValue = 1000000.0, postedValue = 0.0), incoming = (PostedAsset with assetType = "IG-CORP-BOND", faceValue = 2000000.0, postedValue = 0.0)))
  expectRejected "substitutionIneligible" "eligibility schedule" (V.checkMove parityCriteria [] 0.0 [(PostedAsset with assetType = "UST-BILL", faceValue = 1000000.0, postedValue = 0.0), (PostedAsset with assetType = "IG-CORP-BOND", faceValue = 500000.0, postedValue = 0.0)] (Substitution with outgoing = (PostedAsset with assetType = "IG-CORP-BOND", faceValue = 500000.0, postedValue = 0.0), incoming = (PostedAsset with assetType = "HY-BOND", faceValue = 500000.0, postedValue = 0.0)))
