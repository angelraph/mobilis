module CollateralAgreement where

import DA.Optional (fromOptional)
import Types
import AuditReport
import qualified Valuation as V

-- | The static terms of a collateral relationship. Pledgor and securedParty
-- are signatories; the custodian is an observer so it can see and settle
-- calls. Note: `regulator` is recorded here as plain data (the agreement's
-- terms name who the regulator of record is) but is deliberately NOT an
-- observer of this contract -- the regulator only ever sees an AuditReport
-- (see AuditReport.daml). That's the privacy model in one line.
template CollateralAgreement
  with
    pledgor : Party
    securedParty : Party
    custodian : Party
    regulator : Party
    agreementId : Text
    eligibilityCriteria : [EligibilityCriterion]
  where
    signatory pledgor, securedParty
    observer custodian

    ensure all (\c -> c.haircut >= 0.0 && c.haircut < 1.0
                      && c.concentrationLimit > 0.0 && c.concentrationLimit <= 1.0)
               eligibilityCriteria

    nonconsuming choice CollateralAgreement_OpenState : ContractId CollateralAgreementState
      controller custodian
      do
        create CollateralAgreementState with
          pledgor
          securedParty
          custodian
          regulator
          agreementId
          eligibilityCriteria
          requiredCollateral = 0.0
          prices = []
          pricesAsOf = "Par (no marks yet)"
          schedule = []

    nonconsuming choice CollateralAgreement_RequestMarginCall : ContractId MarginCall
      with
        amount : Decimal
        direction : CallDirection
      controller securedParty
      do
        assertMsg "Margin call amount must be positive" (amount > 0.0)
        create MarginCall with
          pledgor
          securedParty
          custodian
          agreementId
          amount
          direction
          status = Requested

    -- | Every asset in the proposal is re-valued here from this agreement's
    -- haircuts. Whatever postedValue a UI or AI suggestion sent is discarded.
    nonconsuming choice CollateralAgreement_ProposeCall : ContractId CollateralCall
      with
        proposer : Party
        action : CallAction
      controller proposer
      do
        assertMsg "Only the pledgor or secured party may propose a call" (proposer == pledgor || proposer == securedParty)
        let assets = case action of
              Delivery a -> [a]
              Return a -> [a]
              Substitution o i -> [o, i]
        assertMsg "Face value must be positive" (all (\a -> a.faceValue > 0.0) assets)
        create CollateralCall with
          pledgor
          securedParty
          custodian
          agreementId
          proposer
          action = V.valueAction eligibilityCriteria action
          status = Outstanding

-- | The running, mutable collateral position for one agreement: the posted
-- schedule and the collateral currently required against the exposure.
-- Re-created (archive + create) each time a call settles or a margin call
-- is applied -- mirrors the split between static terms and live state used
-- in Digital Asset's ex-collateral reference model. The eligibility terms
-- are copied in at open time so every settlement is checked against them.
template CollateralAgreementState
  with
    pledgor : Party
    securedParty : Party
    custodian : Party
    regulator : Party
    agreementId : Text
    eligibilityCriteria : [EligibilityCriterion]
    requiredCollateral : Decimal
    prices : [(Text, Decimal)]   -- latest price mark per asset type (par when absent)
    pricesAsOf : Text            -- when the marks were taken, e.g. "Day 2 close"
    schedule : [PostedAsset]     -- postedValue always at the current marks
  where
    signatory pledgor, securedParty
    observer custodian

    -- | Settlement re-runs the full rulebook against the schedule as it is
    -- now, not as it was when the call was agreed.
    choice State_ApplyCall : ContractId CollateralAgreementState
      with
        action : CallAction
      controller custodian
      do
        newSchedule <- V.enforceMove eligibilityCriteria prices requiredCollateral schedule action
        create this with schedule = newSchedule

    -- | The custodian, as valuation agent, marks prices to market. Every
    -- posted lot is re-valued at the new marks in the same transaction, so
    -- a price drop shows up at once as lower coverage: returns are then
    -- refused until the pledgor tops up, and the regulator's next report
    -- shows the shortfall.
    choice State_MarkPrices : ContractId CollateralAgreementState
      with
        marks : [PriceMark]
        asOf : Text
      controller custodian
      do
        assertMsg "At least one price mark is required" (not (null marks))
        assertMsg "Prices must be positive" (all (\m -> m.price > 0.0) marks)
        let newPrices = V.applyMarks prices marks
        create this with
          prices = newPrices
          pricesAsOf = asOf
          schedule = V.revalue eligibilityCriteria newPrices schedule

    -- | The custodian applies a margin call to the required collateral.
    -- The margin call itself moves Requested -> Applied in the same
    -- transaction, so it can never be applied twice.
    choice State_ApplyMarginCall : (ContractId CollateralAgreementState, ContractId MarginCall)
      with
        marginCallCid : ContractId MarginCall
      controller custodian
      do
        mc <- fetch marginCallCid
        assertMsg "Margin call must be for this agreement" (mc.agreementId == agreementId)
        newMcCid <- exercise marginCallCid MarginCall_MarkApplied
        let newRequired = case mc.direction of
              NeedsMoreCollateral -> requiredCollateral + mc.amount
              ExcessCollateral -> max 0.0 (requiredCollateral - mc.amount)
        newStateCid <- create this with requiredCollateral = newRequired
        return (newStateCid, newMcCid)

    -- | Custodian computes and publishes a fresh audit report from the
    -- current schedule and the agreement's eligibility terms. This is the
    -- only path by which information about this agreement ever reaches the
    -- regulator, and it is a reduced summary, not the raw schedule.
    -- | narrativeOverride lets the custodian's own tooling (e.g. an
    -- LLM-drafted summary, reviewed by a person before it's committed) supply
    -- the plain-English narrative instead of the deterministic default below.
    -- Every number in the report (totals, coverage, positions, breaches) is
    -- always computed here from the live schedule, never taken from the
    -- caller -- only the free-text narrative is ever an input, because that's
    -- the one field that is inherently descriptive rather than a fact the
    -- ledger itself can verify.
    nonconsuming choice State_GenerateAuditReport : ContractId AuditReport
      with
        agreementCid : ContractId CollateralAgreement
        asOfNote : Text
        narrativeOverride : Optional Text
      controller custodian
      do
        agreement <- fetch agreementCid
        assertMsg "Report must be generated for this agreement" (agreement.agreementId == agreementId)
        let total = V.totalPosted schedule
            ratio = V.coverageRatio requiredCollateral schedule
            eligBreaches = V.eligibilityBreaches eligibilityCriteria schedule
            concBreaches = V.concentrationBreaches eligibilityCriteria schedule
            shortfall = max 0.0 (requiredCollateral - total)
            defaultNote
              | not (null eligBreaches) =
                  "Attention: " <> show (length eligBreaches) <> " posted asset type(s) fall outside the agreed eligibility schedule."
              | not (null concBreaches) =
                  "Attention: concentration limit exceeded for " <> show concBreaches <> "."
              | shortfall > 0.0 =
                  "Attention: posted collateral is " <> show shortfall <> " short of the required amount."
              | otherwise =
                  "Fully collateralised: all posted collateral is eligible, within concentration limits, and covers the requirement."
            note = fromOptional defaultNote narrativeOverride
        create AuditReport with
          custodian
          regulator
          pledgor
          securedParty
          agreementId
          asOfNote
          totalPostedValue = total
          requiredCollateral
          coverageRatio = ratio
          valuationAsOf = pricesAsOf
          positionsByAssetType = V.positionsByType schedule
          concentrationByAssetType = V.concentrations schedule
          eligibilityBreaches = eligBreaches
          concentrationBreaches = concBreaches
          narrative = note

-- | A demand from the secured party for more (or less) collateral.
-- Requested -> Applied (custodian adjusts required collateral on the live
-- state) -> Fulfilled (only once the ledger confirms coverage >= required).
template MarginCall
  with
    pledgor : Party
    securedParty : Party
    custodian : Party
    agreementId : Text
    amount : Decimal
    direction : CallDirection
    status : MarginCallStatus
  where
    signatory securedParty
    observer pledgor, custodian

    choice MarginCall_MarkApplied : ContractId MarginCall
      controller custodian
      do
        assertMsg "Margin call has already been applied" (status == Requested)
        create this with status = Applied

    -- | Fulfilment is not a button press: the custodian must point at the
    -- live state, and the ledger checks the position is actually covered.
    choice MarginCall_MarkFulfilled : ContractId MarginCall
      with
        stateCid : ContractId CollateralAgreementState
      controller custodian
      do
        assertMsg "Margin call must be applied before it can be fulfilled" (status == Applied)
        st <- fetch stateCid
        assertMsg "State must be for this agreement" (st.agreementId == agreementId)
        assertMsg
          ("Not fulfilled: posted " <> show (V.totalPosted st.schedule)
           <> " is below required " <> show st.requiredCollateral)
          (V.totalPosted st.schedule >= st.requiredCollateral)
        create this with status = Fulfilled

-- | The other party to a proposed call -- whichever of pledgor/securedParty
-- did not propose it.
counterpartyOf : CollateralCall -> Party
counterpartyOf c = if c.proposer == c.pledgor then c.securedParty else c.pledgor

-- | A proposed movement of collateral: delivery, substitution, or return.
-- Moves Outstanding -> Agreed/Disputed -> Settled, mirroring ex-collateral's
-- Call state machine. The full rulebook (eligibility, is-it-posted,
-- coverage, concentration) runs at Agree time against the live state, so a
-- bad call never reaches Agreed, and again at Settle in case the position
-- moved in between.
template CollateralCall
  with
    pledgor : Party
    securedParty : Party
    custodian : Party
    agreementId : Text
    proposer : Party
    action : CallAction
    status : CallStatus
  where
    signatory pledgor, securedParty
    observer custodian

    choice Call_Agree : ContractId CollateralCall
      with
        stateCid : ContractId CollateralAgreementState
      controller counterpartyOf this
      do
        assertMsg "Call must be Outstanding to agree" (status == Outstanding)
        st <- fetch stateCid
        assertMsg "State must be for this agreement" (st.agreementId == agreementId)
        _ <- V.enforceMove st.eligibilityCriteria st.prices st.requiredCollateral st.schedule action
        create this with status = Agreed

    choice Call_Dispute : ContractId CollateralCall
      with
        reason : Text
      controller counterpartyOf this
      do
        assertMsg "Call must be Outstanding to dispute" (status == Outstanding)
        create this with status = Disputed reason

    choice Call_Settle : (ContractId CollateralCall, ContractId CollateralAgreementState)
      with
        stateCid : ContractId CollateralAgreementState
      controller custodian
      do
        assertMsg "Call must be Agreed to settle" (status == Agreed)
        st <- fetch stateCid
        assertMsg "State must be for this agreement" (st.agreementId == agreementId)
        newStateCid <- exercise stateCid State_ApplyCall with action
        newCallCid <- create this with status = Settled
        return (newCallCid, newStateCid)
