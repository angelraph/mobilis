module Setup where

import Daml.Script
import Types
import CollateralAgreement
import AuditReport

-- | The eligibility schedule used by the demo and the tests: haircut and
-- the largest share of total posted value each asset type may make up.
demoCriteria : [EligibilityCriterion]
demoCriteria =
  [ EligibilityCriterion with assetType = "UST-BILL", haircut = 0.02, concentrationLimit = 1.0
  , EligibilityCriterion with assetType = "IG-CORP-BOND", haircut = 0.05, concentrationLimit = 0.6
  , EligibilityCriterion with assetType = "CASH-USD", haircut = 0.0, concentrationLimit = 1.0
  ]

-- | A posted asset as a caller would send it. postedValue is left at 0.0
-- on purpose: the ledger computes it from the agreement's haircut.
mkAsset : Text -> Decimal -> PostedAsset
mkAsset assetType faceValue = PostedAsset with assetType, faceValue, postedValue = 0.0

-- | A clean starting point for a live or recorded demo: the four parties
-- and an open agreement with an empty schedule, so every step can be
-- performed through the UI. Run it against a fresh sandbox with
-- `daml script --script-name Setup:demoStart` (see scripts/demo-ledger.sh).
demoStart : Script ()
demoStart = script do
  pledgor <- allocatePartyByHint (PartyIdHint "Pledgor")
  securedParty <- allocatePartyByHint (PartyIdHint "SecuredParty")
  custodian <- allocatePartyByHint (PartyIdHint "Custodian")
  regulator <- allocatePartyByHint (PartyIdHint "Regulator")
  agreementCid <- submitMulti [pledgor, securedParty] [] do
    createCmd CollateralAgreement with
      pledgor
      securedParty
      custodian
      regulator
      agreementId = "MOBILIS-CA-0001"
      eligibilityCriteria = demoCriteria
  _ <- submit custodian do exerciseCmd agreementCid CollateralAgreement_OpenState
  pure ()

-- | End-to-end demo scenario for Mobilis: allocates the four parties,
-- opens a collateral agreement, and walks one realistic margin cycle:
-- delivery, margin call, top-up, substitution (UST out, cash in), a
-- rejected ineligible substitution, and an audit report. It then queries
-- the ledger as each party to prove the privacy model out loud. Run with
-- `daml script --dar .daml/dist/mobilis-0.1.0.dar --script-name Setup:setup`
-- (or just open this file in the IDE and click "Script results").
-- Negative paths (undercollateralising and over-concentrated moves, wrong
-- controllers, regulator visibility) are asserted in Tests.daml.
setup : Script ()
setup = script do
  pledgor <- allocatePartyByHint (PartyIdHint "Pledgor")
  securedParty <- allocatePartyByHint (PartyIdHint "SecuredParty")
  custodian <- allocatePartyByHint (PartyIdHint "Custodian")
  regulator <- allocatePartyByHint (PartyIdHint "Regulator")

  agreementCid <- submitMulti [pledgor, securedParty] [] do
    createCmd CollateralAgreement with
      pledgor
      securedParty
      custodian
      regulator
      agreementId = "MOBILIS-CA-0001"
      eligibilityCriteria = demoCriteria

  stateCid0 <- submit custodian do
    exerciseCmd agreementCid CollateralAgreement_OpenState

  -- 1. Delivery: pledgor posts an initial UST bill (1,000,000 face,
  -- 980,000 after the 2% haircut the ledger applies).
  let ust = mkAsset "UST-BILL" 1000000.0
  deliveryCallCid <- submit pledgor do
    exerciseCmd agreementCid CollateralAgreement_ProposeCall with
      proposer = pledgor
      action = Delivery with asset = ust
  deliveryAgreedCid <- submit securedParty do
    exerciseCmd deliveryCallCid Call_Agree with stateCid = stateCid0
  (_, stateCid1) <- submit custodian do
    exerciseCmd deliveryAgreedCid Call_Settle with stateCid = stateCid0

  -- 2. Margin call: the exposure moved and the secured party now needs
  -- 1,400,000 of collateral. The custodian applies it to the live state:
  -- coverage drops to 70%.
  marginCallCid <- submit securedParty do
    exerciseCmd agreementCid CollateralAgreement_RequestMarginCall with
      amount = 1400000.0
      direction = NeedsMoreCollateral
  (stateCid2, appliedMcCid) <- submit custodian do
    exerciseCmd stateCid1 State_ApplyMarginCall with marginCallCid

  -- 3. Top-up: pledgor delivers an IG corporate bond (500,000 face,
  -- 475,000 posted). Total 1,455,000 >= 1,400,000 and the corp bond is
  -- ~33% of the book, inside its 60% limit. Only now can the custodian
  -- mark the margin call fulfilled -- the ledger checks coverage.
  let corp = mkAsset "IG-CORP-BOND" 500000.0
  topUpCallCid <- submit pledgor do
    exerciseCmd agreementCid CollateralAgreement_ProposeCall with
      proposer = pledgor
      action = Delivery with asset = corp
  topUpAgreedCid <- submit securedParty do
    exerciseCmd topUpCallCid Call_Agree with stateCid = stateCid2
  (_, stateCid3) <- submit custodian do
    exerciseCmd topUpAgreedCid Call_Settle with stateCid = stateCid2
  _ <- submit custodian do
    exerciseCmd appliedMcCid MarginCall_MarkFulfilled with stateCid = stateCid3

  -- 4. Substitution: the pledgor needs its Treasury back to fund a repo
  -- elsewhere, and swaps it for cash in one atomic, multi-party move --
  -- the flagship collateral-mobility moment. The ledger checks the book
  -- stays covered and within limits after the swap.
  let cash = mkAsset "CASH-USD" 1000000.0
  subCallCid <- submit pledgor do
    exerciseCmd agreementCid CollateralAgreement_ProposeCall with
      proposer = pledgor
      action = Substitution with outgoing = ust, incoming = cash
  subAgreedCid <- submit securedParty do
    exerciseCmd subCallCid Call_Agree with stateCid = stateCid3
  (_, stateCid4) <- submit custodian do
    exerciseCmd subAgreedCid Call_Settle with stateCid = stateCid3

  -- 5. An ineligible substitution: the ledger refuses to let it be agreed,
  -- so the secured party disputes it instead.
  let junk = mkAsset "HY-BOND" 500000.0
  badCallCid <- submit pledgor do
    exerciseCmd agreementCid CollateralAgreement_ProposeCall with
      proposer = pledgor
      action = Substitution with outgoing = corp, incoming = junk
  submitMustFail securedParty do
    exerciseCmd badCallCid Call_Agree with stateCid = stateCid4
  _ <- submit securedParty do
    exerciseCmd badCallCid Call_Dispute with reason = "HY-BOND is not on the agreed eligibility schedule"

  -- 6. Audit report: custodian generates it. The regulator's participant
  -- can only ever hold this one contract type for this agreement.
  _ <- submit custodian do
    exerciseCmd stateCid4 State_GenerateAuditReport with
      agreementCid
      asOfNote = "End of Day 1"
      narrativeOverride = None

  -- 7. Privacy check: query the ledger as each party and print counts.
  -- This is the assertion that matters most before the live demo.
  regulatorReports <- query @AuditReport regulator
  regulatorCalls <- query @CollateralCall regulator
  regulatorState <- query @CollateralAgreementState regulator
  pledgorCalls <- query @CollateralCall pledgor
  custodianState <- query @CollateralAgreementState custodian

  debug ("Regulator sees " <> show (length regulatorReports) <> " audit report(s) -- expect 1")
  debug ("Regulator sees " <> show (length regulatorCalls) <> " raw collateral call(s) -- expect 0")
  debug ("Regulator sees " <> show (length regulatorState) <> " raw schedule state(s) -- expect 0")
  debug ("Pledgor sees " <> show (length pledgorCalls) <> " collateral call(s) it is party to")
  debug ("Custodian sees " <> show (length custodianState) <> " live schedule state(s)")

  return ()
